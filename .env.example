NEXT_PUBLIC_CANDY_MACHINE_ID=your-candy-machine-id-here
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_TREASURY_ADDRESS=your-treasury-address-here
NEXT_PUBLIC_NETWORK=devnet

# Crossmint embedded MPC wallet (claim flow). Create a client API key in the Crossmint console with
# wallet scopes; must match staging vs production. See https://docs.crossmint.com/wallets/quickstarts/react
# NEXT_PUBLIC_CROSSMINT_API_KEY is also accepted (docs name).
NEXT_PUBLIC_CROSSMINT_CLIENT_API_KEY=

# Optional: URL for “Need a Crossmint wallet?” / mint page Crossmint button (default: React wallets quickstart).
# Example console: https://www.crossmint.com/console/projects/apiKeys
# NEXT_PUBLIC_CROSSMINT_WALLET_HELP_URL=https://docs.crossmint.com/wallets/quickstarts/react
# Bookmarkable portal where users view NFTs after email/Google Crossmint claim:
# NEXT_PUBLIC_CROSSMINT_USER_COLLECTION_URL=https://www.crossmint.com/user/collection

# cNFT Configuration (for frontend display)
NEXT_PUBLIC_CNFT_COLLECTION=DVaJS3FNBHvrWvZAEFNyNoi67ZqzJJ7gUoX6abHrQsM
NEXT_PUBLIC_CNFT_MERKLE_TREE=E3Do6eop2Bf2vv3nRCdsaE9uqosYyEaAe3zA1MNQNkUG
NEXT_PUBLIC_CNFT_METADATA_URI=https://gateway.pinata.cloud/ipfs/your_metadata_folder_cid

# cNFT Backend Configuration (server-side only, DO NOT expose to client)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_api_key
CNFT_COLLECTION=DVaJS3FNBHvrWvZAEFNyNoi67ZqzJJ7gUoX6abHrQsM
CNFT_MERKLE_TREE=E3Do6eop2Bf2vv3nRCdsaE9uqosYyEaAe3zA1MNQNkUG
CNFT_METADATA_URI=https://gateway.pinata.cloud/ipfs/your_metadata_folder_cid

# IMPORTANT: Set this to your authority keypair's secret key (base58 encoded)
# Generate using: node -e "const k=require('fs').readFileSync(process.env.HOME+'/.config/solana/id.json');console.log(require('bs58').encode(Buffer.from(JSON.parse(k))))"
# NEVER commit this value to git!
CNFT_AUTHORITY_SECRET_KEY=your_base58_encoded_secret_key_here

# Bearer token for /admin and /api/admin/*. Sent as `Authorization: Bearer <key>` or `x-admin-key`.
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CLAIM_ADMIN_KEY=

# Persistent claim store + rate limiting. Without these the claim counter falls back to a local file,
# which does NOT persist on Vercel serverless and can hand out duplicate metadata indices.
# The Vercel KV integration sets KV_REST_API_URL / KV_REST_API_TOKEN, which are accepted as aliases.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
