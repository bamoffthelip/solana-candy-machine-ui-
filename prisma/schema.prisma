generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  campaigns   Campaign[]
  projects    Project[]
}

model Project {
  id             String     @id @default(cuid())
  businessId     String
  business       Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  slug           String     @unique
  symbol         String?
  collectionMint String?
  merkleTree     String?
  metadataBase   String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  campaigns      Campaign[]
  mintEvents     MintEvent[]

  @@index([businessId])
}

model Campaign {
  id             String     @id @default(cuid())
  businessId     String
  projectId      String
  business       Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean    @default(false)
  tokenGateRule  Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  mintEvents     MintEvent[]

  @@index([businessId])
  @@index([projectId])
}

model MintEvent {
  id            String     @id @default(cuid())
  campaignId    String?
  projectId     String
  campaign      Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recipient     String
  signature     String?
  metadataUri   String
  metadataIndex Int
  status        String
  createdAt     DateTime   @default(now())

  @@index([projectId, metadataIndex])
  @@index([recipient])
}

model MintJob {
  id             String   @id @default(cuid())
  projectId      String
  campaignId     String?
  recipient      String
  idempotencyKey String   @unique
  status         String
  metadataIndex  Int?
  txSignature    String?
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId, status])
  @@index([recipient])
}

model TokenGatePolicy {
  id                 String   @id @default(cuid())
  campaignId         String   @unique
  enabled            Boolean  @default(false)
  minTokenBalance    Float?
  requiredCollection String?
  allowlistJson      Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MpcSession {
  id             String   @id @default(cuid())
  walletAddress  String
  state          String
  deviceId       String?
  challengeNonce String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([walletAddress, state])
}

model WebhookEvent {
  id           String   @id @default(cuid())
  source       String
  eventType    String
  payload      Json
  signature    String?
  processed    Boolean  @default(false)
  processedAt  DateTime?
  errorMessage String?
  receivedAt   DateTime @default(now())

  @@index([source, eventType])
  @@index([processed, receivedAt])
}
